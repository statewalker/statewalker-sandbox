{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentWidth": 2
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/httpeers-browser-mesh/src/mesh.ts",
        "apps/httpeers-browser-mesh/src/hub.ts",
        "apps/httpeers-browser-mesh/src/relay-discovery.ts",
        "apps/httpeers-browser-mesh/src/app.ts",
        "apps/httpeers-browser-mesh/tests/browser.spec.ts",
        "apps/httpeers-browser-mesh/tests/node-verify.mjs"
      ],
      "formatter": { "enabled": false },
      "assist": { "enabled": false },
      "linter": { "enabled": false }
    },
    {
      "includes": [
        "apps/httpeers-wire-protos/src/wire.ts",
        "apps/httpeers-wire-protos/src/transport-wire.ts",
        "apps/httpeers-wire-protos/src/types.ts",
        "apps/httpeers-wire-protos/src/peer-context.ts",
        "apps/httpeers-wire-protos/src/wire.test.ts",
        "apps/httpeers-wire-protos/src/relay.test.ts",
        "apps/httpeers-wire-protos/src/robustness.test.ts"
      ],
      "formatter": { "enabled": false },
      "assist": { "enabled": false },
      "linter": { "enabled": false }
    }
  ]
}
