{
  "name": "@statewalker/statewalker-sandbox-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "description": "Experimental / scheduled-for-refactor packages — internal use only.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-sandbox/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-sandbox#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-sandbox.git"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:nightly": "pnpm run test:nightly:browser; browser=$?; pnpm run test:nightly:e2e && exit $browser",
    "test:nightly:browser": "pnpm --no-bail --workspace-concurrency=1 --filter @statewalker/mvc-blueprint-00 --filter @statewalker/mvc-blueprint-01 --filter @statewalker/mvc-blueprint-02 --filter @statewalker/mvc-blueprint-03 --filter @statewalker/vcs-protos --filter @statewalker/fm-protos --filter @statewalker/flue-capfs-do run test:browser",
    "test:nightly:e2e": "pnpm --filter @statewalker/tesseract-do run fixtures && pnpm --filter @statewalker/tesseract-do run test:e2e",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:tests": "pnpm -r run typecheck:tests",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "publish-all": "pnpm run build && pnpm -r publish --access public --no-git-checks",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release-packages": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "version": ""
}
