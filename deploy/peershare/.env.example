# Where the page lives, and the zone its Guests' sessions open in. The shell
# admits only parent pages in PARENT_ZONE (the zone itself or one label under it).
PAGE_HOST=tools.sandclaw.ai
PARENT_ZONE=sandclaw.ai
SESSION_ZONE=p.sandclaw.ai
HTTPS_PORT=443

# httpeers' relay; its peer id is in https://relay.httpeers.net/.well-known/httpeers-relay.json
RELAY_ADDRS=/dns4/relay.httpeers.net/tcp/443/wss/p2p/<relay peer id>

# TLS: the wildcard *.SESSION_ZONE needs a DNS-01 challenge, so production uses an
# ingress image with a DNS provider module (httpeers' deploy/ingress is one) and sets
# TLS to its issuer block; a certificate pair works too: TLS=/certs/cert.pem /certs/key.pem
TLS=you@example.com
