{
  "name": "@statewalker/service-rpc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Experimental JSON-RPC / websocket transport. Future uncertain.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-sandbox/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-sandbox/tree/main/packages/service-rpc#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-sandbox.git",
    "directory": "packages/service-rpc"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist/**",
    "src/**"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "tsx watch ./src/index.ts",
    "test": "pnpm run typecheck:tests && vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "comlink": "catalog:",
    "@statewalker/shared-generators": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "isomorphic-ws": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  }
}
