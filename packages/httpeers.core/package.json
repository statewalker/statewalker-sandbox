{
  "name": "@statewalker/httpeers.core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared contracts, membership tokens and hub registries for the httpeers mesh.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-sandbox/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-sandbox/tree/main/packages/httpeers.core#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-sandbox.git",
    "directory": "packages/httpeers.core"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist/**",
    "src/**"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "pnpm run typecheck:tests && vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "catalog:",
    "@chainsafe/libp2p-yamux": "catalog:",
    "@libp2p/crypto": "catalog:",
    "@libp2p/identify": "catalog:",
    "@libp2p/interface": "catalog:",
    "@libp2p/peer-id": "catalog:",
    "@libp2p/tcp": "catalog:",
    "@multiformats/multiaddr": "catalog:",
    "@statewalker/webrun-biscuit": "catalog:",
    "@statewalker/webrun-http-streams": "catalog:",
    "@statewalker/webrun-streams-libp2p": "catalog:",
    "libp2p": "catalog:"
  },
  "devDependencies": {
    "@biscuit-auth/biscuit-wasm": "catalog:",
    "@types/node": "catalog:",
    "multiformats": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
