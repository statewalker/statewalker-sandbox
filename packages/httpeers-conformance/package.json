{
  "name": "@statewalker/httpeers-conformance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "One test per numbered criterion of the httpeers block API. Measures an implementation against the spec.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-sandbox/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-sandbox/tree/main/packages/httpeers-conformance#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-sandbox.git",
    "directory": "packages/httpeers-conformance"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "sync-criteria": "node scripts/sync-criteria.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "report:gap": "vitest run --config vitest.gap.config.ts"
  },
  "dependencies": {
    "@libp2p/interface": "catalog:",
    "@libp2p/peer-id": "catalog:",
    "@statewalker/httpeers.core": "workspace:^",
