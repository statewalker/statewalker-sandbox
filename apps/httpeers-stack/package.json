{
  "name": "@statewalker/httpeers-stack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The installable reference deployment of the httpeers mesh design.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statewalker/statewalker-sandbox.git"
  },
  "scripts": {
    "test": "pnpm run typecheck:tests && vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "setup": "tsx src/setup/main.ts",
    "start": "bash scripts/start.sh",
    "start:relay": "tsx src/relay/main.ts",
    "start:hub": "tsx src/hub/main.ts",
    "start:static": "tsx src/static-server/main.ts",
    "dev:app": "vite --config vite.app.config.ts",
    "build:app": "vite build --config vite.app.config.ts",
    "dev:image-peer": "vite --config vite.image-peer.config.ts",
    "build:image-peer": "vite build --config vite.image-peer.config.ts"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/circuit-relay-v2": "4.2.11",
    "@libp2p/crypto": "5.1.22",
    "@libp2p/identify": "4.1.12",
    "@libp2p/interface": "3.2.5",
    "@libp2p/peer-id": "6.0.14",
    "@libp2p/tcp": "11.0.26",
    "@libp2p/webrtc": "6.0.29",
    "@libp2p/websockets": "10.1.19",
    "@multiformats/multiaddr": "13.0.3",
    "@statewalker/httpeers.core": "workspace:*",
    "@statewalker/webrun-files": "workspace:*",
    "@statewalker/webrun-files-mem": "workspace:*",
    "@statewalker/webrun-http-browser": "workspace:*",
    "hono": "catalog:",
    "idb-keyval": "catalog:",
    "libp2p": "3.3.8"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright": "1.58.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
