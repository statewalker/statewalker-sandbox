{
  "name": "@statewalker/httpeers-stack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The installable reference deployment of the httpeers mesh design.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-sandbox/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-sandbox/tree/main/apps/httpeers-stack#readme",
  "license": "MIT",
  "comment:exports": "So apps/httpeers-lib-protos can import the PROVEN code unchanged rather than copy it — that it need not be copied is what those rungs are measuring. Source-only, like httpeers.core's own exports map.",
  "exports": {
    "./src/*.js": "./src/*.ts",
    "./tests/*.js": "./tests/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-sandbox.git",
    "directory": "apps/httpeers-stack"
  },
  "scripts": {
    "test": "pnpm run typecheck:tests && vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "bootstrap": "tsx src/setup/main.ts",
    "start": "bash scripts/start.sh",
    "start:relay": "tsx src/relay/main.ts",
    "start:hub": "tsx src/hub/main.ts",
    "start:static": "tsx src/static-server/main.ts",
    "dev:app": "vite --config vite.app.config.ts",
    "build:app": "vite build --config vite.app.config.ts",
    "dev:image-peer": "vite --config vite.image-peer.config.ts",
    "build:image-peer": "vite build --config vite.image-peer.config.ts",
    "dev:hub-page": "vite --config vite.hub.config.ts",
    "dev:proxy": "vite --config vite.proxy.config.ts",
    "build:hub-page": "vite build --config vite.hub.config.ts",
    "build:proxy": "vite build --config vite.proxy.config.ts"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "catalog:",
    "@chainsafe/libp2p-yamux": "catalog:",
    "@libp2p/circuit-relay-v2": "catalog:",
    "@libp2p/crypto": "catalog:",
    "@libp2p/identify": "catalog:",
    "@libp2p/interface": "catalog:",
    "@libp2p/peer-id": "catalog:",
    "@libp2p/tcp": "catalog:",
    "@libp2p/webrtc": "catalog:",
    "@libp2p/websockets": "catalog:",
    "@multiformats/multiaddr": "catalog:",
    "@statewalker/httpeers.core": "workspace:^",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/webrun-http-browser": "catalog:",
    "hono": "catalog:",
    "html5-qrcode": "catalog:",
    "idb-keyval": "catalog:",
    "libp2p": "catalog:",
    "qrcode-generator": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "jsqr": "catalog:",
    "playwright": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
