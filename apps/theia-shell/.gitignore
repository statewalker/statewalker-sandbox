node_modules/
lib/
# …but not source folders named lib (build output is lib/ next to src/).
!**/src/**/lib/
src-gen/
gen-webpack.config.js
gen-webpack.node.config.js
webpack.config.js
test-results/
playwright-report/
plugins/
# Theia regenerates a stock esbuild.mjs where it is missing; the app's own is
# customised (the mesh edge's ServiceWorker, webrun-http-browser's import.meta.url).
esbuild.mjs
!app/esbuild.mjs
gen-esbuild.*.mjs
