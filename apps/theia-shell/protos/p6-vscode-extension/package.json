{
  "name": "@theia-shell/p6-vscode-extension",
  "version": "0.0.0",
  "private": true,
  "theia": {
    "target": "browser-only",
    "frontend": {
      "config": {
        "applicationName": "P6 VS Code web extension",
        "preferences": {
          "security.workspace.trust.enabled": false
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm --filter @theia-shell/p6-extension build && theia build --mode development && node scripts/prepare-late-plugins.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@theia-shell/p3-extension": "workspace:*",
    "@theia-shell/p6-extension": "workspace:*",
    "@theia-shell/theia-files-api": "workspace:*",
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/plugin-ext": "1.76.0",
    "@theia/plugin-ext-vscode": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/workspace": "1.76.0"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0",
    "@theia/application-manager": "1.76.0"
  },
  "theiaPluginsDir": "plugins-src"
}
