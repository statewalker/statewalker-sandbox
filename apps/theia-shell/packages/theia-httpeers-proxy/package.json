{
  "name": "@theia-shell/theia-httpeers-proxy",
  "version": "0.0.0",
  "private": true,
  "description": "Theia extension: expose outside HTTP origins to the httpeers mesh through this browser, with a route table editor and a test console.",
  "main": "lib/common/index.js",
  "types": "lib/common/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "theiaExtensions": [
    {
      "frontendOnly": "lib/browser/proxy-frontend-module"
    }
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@statewalker/httpeers-core": "link:../../../../../httpeers/packages/httpeers-core",
    "@statewalker/httpeers-join": "link:../../../../../httpeers/packages/httpeers-join",
    "@statewalker/webrun-http-proxy": "0.2.0",
    "@theia-shell/theia-httpeers": "workspace:*",
    "@theia/core": "1.76.0",
    "hono": "4.13.9"
  }
}
