  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/workspace": "1.76.0"
  }
}
