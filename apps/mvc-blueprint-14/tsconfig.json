{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@kernel": ["./src/kernel/index.ts"],
      "@kit/*": ["./src/kits/*/index.ts"],
      "@b/*": ["./src/bundles/*/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "*.ts"]
}
