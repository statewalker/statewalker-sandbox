{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "paths": {
      "@fm/core": ["./src/core/index.ts"],
      "@fm/app": ["./src/app/index.ts"],
      "@fm/ui": ["./src/ui/index.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*", "fm-app/test/**/*"]
}
