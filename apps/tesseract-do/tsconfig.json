{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "tesseract-wasm": ["./node_modules/tesseract-wasm/dist/index.d.ts"]
    }
  },
  "include": ["src"]
}
