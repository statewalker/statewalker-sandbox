{
  "name": "@statewalker/pdf-portabletext-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PROTOTYPE \u2014 demo UI and test harness for @statewalker/pdf-portabletext (in-browser PDF to PortableText).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-sandbox.git",
    "directory": "apps/pdf-portabletext-prototype"
  },
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-sandbox/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-sandbox/tree/main/apps/pdf-portabletext-prototype#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5181",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixture": "tsx scripts/make-fixture.ts",
    "e2e": "tsx e2e-browser/e2e.ts",
    "corpus:fetch": "NODE_USE_ENV_PROXY=1 tsx scripts/fetch-corpus.ts",
    "corpus": "tsx e2e-browser/corpus.ts",
    "corpus:md": "tsx scripts/write-corpus-md.ts"
  },
  "dependencies": {
    "@statewalker/pdf-portabletext": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pdf-lib": "^1.17.1",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
