{
  "name": "@statewalker/mvc-blueprint-signals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The MVC blueprint on signals — the same architecture, with its model substrate behind one signals contract.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "test:B0": "vitest run B0-boundaries",
    "test:B1": "vitest run B1-models",
    "test:B2": "vitest run B2-commands",
    "test:B3": "vitest run B3-controller",
    "test:B4": "vitest run B4-view-protocol",
    "test:B5": "vitest run --config vitest.browser.config.ts B5-views",
    "test:B6": "vitest run B6-app && vitest run --config vitest.browser.config.ts B6-app"
  },
  "dependencies": {
    "@preact/signals-core": "1.14.4",
    "@statewalker/shared-commands": "0.2.1",
    "@statewalker/shared-registry": "catalog:",
    "@statewalker/ui.view.shadcn": "catalog:",
    "alien-signals": "3.2.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "^5.0.0",
    "playwright": "1.58.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^5.0.0"
  }
}
