{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@fm/core": ["./lib/fm-core/src/index.ts"],
      "@fm/app": ["./lib/fm-app/src/index.ts"],
      "@fm/ui": ["./lib/fm-ui/src/index.ts"]
    }
  },
  "include": ["lib/**/*", "*/tests/**/*", "vitest.config.ts"]
}
