{
  "name": "@statewalker/fm-protos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The File Manager prototype ladder, restored as runnable code: twenty-one rungs over one cumulative fm-core / fm-app / fm-ui.",
  "scripts": {
    "test": "vitest run",
    "test:all": "npm run test && npm run test:browser",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "test:P0": "vitest run P0-architecture-skeleton",
    "test:P1": "vitest run P1-file-stats-discriminant",
    "test:P2": "vitest run P2-storage-registry",
    "test:P3": "vitest run P3-job-engine-walk-batch-cancel",
    "test:P4": "vitest run P4-checkpoint-and-resume",
    "test:P5": "vitest run P5-conflict-resolution",
    "test:P6": "vitest run P6-job-queue-and-lifetimes",
    "test:C0": "vitest run C0-packages-and-core-decisions",
    "test:C1": "vitest run C1-model-kit",
    "test:C2": "vitest run C2-panel-set-algebra",
    "test:C3": "vitest run C3-listing-lifecycle",
    "test:C4": "vitest run C4-change-notification",
    "test:C5": "vitest run C5-command-surface-and-override",
    "test:C05": "vitest run C05-real-adapters",
    "test:D1": "vitest run D1-ui-protocol",
    "test:D15": "vitest run D15-conflict-dialog-end-to-end",
    "test:D2a": "vitest run D2a-model-driven-table",
    "test:D2b": "vitest run --config vitest.browser.config.ts",
    "test:D3": "vitest run D3-config-session-ephemeral",
    "test:D4": "vitest run D4-open-storage-by-command",
    "test:D5": "vitest run D5-assembly-end-to-end"
  },
  "dependencies": {
    "@statewalker/shared-baseclass": "0.1.1",
    "@statewalker/shared-commands": "0.2.1",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-browser": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/webrun-files-node": "catalog:",
    "hightable": "0.26.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "^5.0.0",
    "happy-dom": "20.14.0",
    "playwright": "1.58.0",
    "typescript": "catalog:",
    "vitest": "^5.0.0"
  }
}
