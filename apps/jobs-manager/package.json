{
  "name": "@statewalker/jobs-manager-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runs named long-running tasks as shell commands (launcher by extension, JSONL stdout), stores their messages per job and serves them over REST (NDJSON logs, SSE events).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-sandbox.git",
    "directory": "apps/jobs-manager"
  },
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-sandbox/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-sandbox/tree/main/apps/jobs-manager#readme",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "jobs-server": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "report": "node scripts/parallel-report.ts",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
