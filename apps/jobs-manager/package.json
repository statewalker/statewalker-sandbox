{
  "name": "@statewalker/jobs-manager-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runs named long-running tasks as shell commands (launcher by extension, JSONL stdout), stores their messages per job and serves them over REST (NDJSON logs, SSE events) and MCP, through a runtime-agnostic Hono app.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-sandbox.git",
    "directory": "apps/jobs-manager"
  },
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-sandbox/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-sandbox/tree/main/apps/jobs-manager#readme",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./web": {
      "types": "./src/web.ts",
      "import": "./src/web.ts"
    },
    "./dist": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "jobs": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node src/cli.ts serve",
    "jobs": "node src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "report": "node scripts/parallel-report.ts",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "citty": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "main": "src/index.ts",
  "files": [
    "dist/**",
    "src/**"
  ]
}
