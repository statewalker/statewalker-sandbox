{
  "name": "@statewalker/peershare-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The PeerShare Bridge: a locked-down loopback relay from the PeerShare page to the Sharer's local services, shipped as one compiled file.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-sandbox/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-sandbox/tree/main/apps/peershare-bridge#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-sandbox.git",
    "directory": "apps/peershare-bridge"
  },
  "scripts": {
    "start": "bun run src/main.ts --open",
    "compile": "bun build --compile src/main.ts --outfile dist/peershare-bridge",
    "test": "pnpm run typecheck:tests && vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "compile:all": "node scripts/compile-all.mjs dist"
  },
  "dependencies": {
    "@statewalker/httpeers-share": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
