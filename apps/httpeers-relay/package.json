{
  "name": "@statewalker/httpeers-relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A deployable httpeers relay: a stock libp2p Circuit Relay v2 server, configured entirely by environment.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statewalker/statewalker-sandbox.git"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "src/**"
  ],
  "scripts": {
    "start": "tsx src/main.ts",
    "keygen": "tsx src/keygen.ts",
    "test": "pnpm run typecheck:tests && vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/circuit-relay-v2": "4.2.11",
    "@libp2p/crypto": "5.1.22",
    "@libp2p/identify": "4.1.12",
    "@libp2p/interface": "3.2.5",
    "@libp2p/peer-id": "6.0.14",
    "@libp2p/websockets": "10.1.19",
    "@multiformats/multiaddr": "13.0.3",
    "libp2p": "3.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
