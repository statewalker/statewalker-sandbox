    "demo:03-access-control": "tsx 03-access-control/main.ts",
    "demo:04-backpressure": "tsx 04-backpressure/main.ts",
    "demo:05-router-mounts": "tsx 05-router-mounts/main.ts",
    "demo:06-open-relay": "tsx 06-open-relay/main.ts",
    "demo:07-access-tree": "tsx 07-access-tree/main.ts",
    "demo:08-revocation": "tsx 08-revocation/main.ts",
    "demo:09-role-vocabulary": "tsx 09-role-vocabulary/main.ts",
    "demo:all": "pnpm demo:01-identity && pnpm demo:02-http-over-p2p && pnpm demo:03-access-control && pnpm demo:04-backpressure && pnpm demo:05-router-mounts && pnpm demo:06-open-relay && pnpm demo:07-access-tree && pnpm demo:08-revocation && pnpm demo:09-role-vocabulary && pnpm demo:10-token-chain",
